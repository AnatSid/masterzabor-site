# Local GSC tooling only. Copy to .env.gsc.local after implementation review.
# Never add these values to Vercel or share them in chat.
# GSC_SITE_URL is a Search Console property ID, not a page canonical URL.
GSC_CLIENT_ID=REPLACE_WITH_GSC_OAUTH_CLIENT_ID
GSC_CLIENT_SECRET=REPLACE_WITH_GSC_OAUTH_CLIENT_SECRET
GSC_REFRESH_TOKEN=REPLACE_WITH_GSC_READONLY_REFRESH_TOKEN
GSC_SITE_URL=sc-domain:masterzabor.by

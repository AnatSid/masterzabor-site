# =============================================================================
# PRODUCTION ENV CHECKLIST (Vercel)
# =============================================================================

# --- REQUIRED: Telegram (leads + bot + cron reports) ---
# TELEGRAM_BOT_TOKEN     → lib/telegram.ts (sendMessage)
# TELEGRAM_CHAT_ID       → lib/telegram.ts, app/api/telegram-webhook/route.ts
# TELEGRAM_WEBHOOK_SECRET → webhook header validation

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

# --- REQUIRED: Leads storage + stats API ---
# KV_REST_API_URL        → @vercel/kv (lib/leads.ts)
# KV_REST_API_TOKEN      → @vercel/kv
# STATS_API_TOKEN        → app/api/stats/route.ts (Bearer)
# CRON_SECRET            → app/api/cron/daily-report, analytics-report

KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token
STATS_API_TOKEN=your_stats_api_token
CRON_SECRET=your_cron_secret

# --- REQUIRED: Public counters (browser, app/layout.tsx) ---
# NEXT_PUBLIC_YM_ID      → Yandex Metrika script
# NEXT_PUBLIC_GA_ID      → Google gtag (e.g. G-DT0TXHL4DM)

NEXT_PUBLIC_YM_ID=your_yandex_metrika_id
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- REQUIRED: Traffic analytics API (server-side) ---
# GA_PROPERTY_ID         → lib/analytics/google.ts
# GOOGLE_CLIENT_ID       → OAuth refresh (google.ts)
# GOOGLE_CLIENT_SECRET   → OAuth refresh
# GOOGLE_REFRESH_TOKEN   → OAuth refresh (one-time setup, then stable)
# YANDEX_METRIKA_COUNTER_ID → lib/analytics/yandex.ts
# YANDEX_METRIKA_TOKEN   → Yandex Metrika OAuth token

GA_PROPERTY_ID=your_ga4_property_id
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
YANDEX_METRIKA_COUNTER_ID=your_yandex_metrika_counter_id
YANDEX_METRIKA_TOKEN=your_yandex_metrika_oauth_token

# --- OPTIONAL ---
# (none for analytics; Vercel may inject VERCEL_* automatically)

# --- DEPRECATED / NO LONGER USED (do not set on Vercel) ---
# GOOGLE_CLIENT_EMAIL    — service account removed from code
# GOOGLE_PRIVATE_KEY     — service account removed from code
# REDIS_URL              — use KV_REST_* only
# KV_URL                 — Vercel internal alias, not required in app code

# --- WEBHOOK URL (not an env var) ---
# Register: https://www.masterzabor.by/api/telegram-webhook
# See: lib/constants.ts TELEGRAM_WEBHOOK_URL
# Script: npx tsx scripts/set-telegram-bot.ts
